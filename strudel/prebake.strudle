//borrowed from switch angel
register('acidenv', (x, pat)=> pat.lpf(100).lpenv(x*9).lps(.2).lpd(9.12))


// https://gist.github.com/walfie/b049d32368cb579a5980d4fb49d416ba
const romanChordMapping = { i: 0, ii: 1, iii: 2, iv: 3, v: 4, vi: 5, vii: 6 }
register('romanChord', function (scaleName, pat) {
  return pat.as("roman:chordSuffix").fmap(({ roman, chordSuffix}) => {
    const lower = roman.toLowerCase();
    return n(romanChordMapping[lower]).scale(scaleName).fmap(value => {
      return value.note.slice(0, -1) + (roman == lower ? 'm' : '') + (chordSuffix || '');
    }).chord();
  }).outerJoin();
});


//mix hydra sources together
window.smoothMix = (sources, speed = 0.1) => {
  let result = src(sources[0])

  for (let i = 1; i < sources.length; i++) {
    result = result.blend(
      src(sources[i]),
      () => (
        Math.sin(
          time * speed +
          i * (Math.PI * 2 / sources.length)
        ) + 1
      ) / 2      
    )
  }
  return result
}

//Need to add this to strudel
window.baseMidin = (b, c, m, n, i) =>
  b(c(m).range(0, (n**i)-1).round(), n, i)

// Base Class for Canvas visulaisers
class CachedCanvasVisualiser {
  constructor(width, height) {

    this.canvas = document.createElement('canvas')
    this.canvas.width = width
    this.canvas.height = height

    this.ctx = this.canvas.getContext('2d')

    this.staticCanvas = document.createElement('canvas')
    this.staticCanvas.width = width
    this.staticCanvas.height = height

    this.staticCtx = this.staticCanvas.getContext('2d')

    this.running = false
  }

  start() {
    this.running = true
  }

  stop() {
    this.running = false
  }

}

// Shows Midi based around the layout of my Novation  Launch Control
class MidiVisualiser extends CachedCanvasVisualiser {

  constructor({
    cc,
    width = 960,
    height = 540,
    refreshMs = 500
  }, valueMappings = {}) {

    super(width, height)

    if (valueMappings === null || typeof valueMappings !== 'object' || Array.isArray(valueMappings)) {
      throw new TypeError('MidiVisualiser value mappings must be an object keyed by CC number')
    }

    this.cc = cc
    this.refreshMs = refreshMs
    this.valueMappings = valueMappings

    this.topRow = [21,22,23,24,25,26,27,28]
    this.bottomRow = [41,42,43,44,45,46,47,48]

    this.lastDrawTime = 0

    this.cachedValues = new Map()

    this.buildStaticLayer()
  }

  getTrackGeometry(col,row) {
    const trackWidth = 50
    const rowHeight = this.canvas.height / 2
    const trackHeight = Math.min(180, rowHeight * 2 / 3)
    const horizontalMargin = 40
    const columnSpacing =
      (this.canvas.width - horizontalMargin * 2 - trackWidth) /
      (this.topRow.length - 1)

    return {
      x: horizontalMargin + col * columnSpacing,
      y: row * rowHeight + (rowHeight - trackHeight) / 2,
      width: trackWidth,
      height: trackHeight
    }
  }

  buildStaticLayer() {

    const ctx = this.staticCtx

    ctx.fillStyle = 'black'
    ctx.fillRect(0,0,this.canvas.width,this.canvas.height)

    const drawTrack = (ccNum,col,row) => {

      const { x, y, width, height } =
        this.getTrackGeometry(col,row)

      ctx.fillStyle = '#222'
      ctx.fillRect(
        x,
        y,
        width,
        height
      )

      ctx.fillStyle = 'white'
      ctx.font = '16px monospace'
      ctx.fillText(
        ccNum,
        x + 12,
        y + height + 22
      )
    }

    this.topRow.forEach((n,i)=>
      drawTrack(n,i,0))

    this.bottomRow.forEach((n,i)=>
      drawTrack(n,i,1))
  }

  getCCValue(n) {

    const value =
      this.cc(n).firstCycleValues?.[0] ?? 0

    const previous =
      this.cachedValues.get(n)

    if (previous === value) {
      return {
        changed:false,
        value
      }
    }

    this.cachedValues.set(n,value)

    return {
      changed:true,
      value
    }
  }

  drawMeter(n,col,row,color) {

    const { value } =
      this.getCCValue(n)

    const { x, y, width, height } =
      this.getTrackGeometry(col,row)
    const h = value * height

    this.ctx.fillStyle = color

    this.ctx.fillRect(
      x,
      y + height - h,
      width,
      h
    )

    this.ctx.fillStyle = 'white'
    this.ctx.font = '16px monospace'
    this.ctx.textAlign = 'center'

    let displayValue = value.toFixed(2)
    if (Object.hasOwn(this.valueMappings, n)) {
      const mapped = this.valueMappings[n]
      if (mapped !== null && typeof mapped === 'object' && typeof mapped.queryArc === 'function') {
        const events = mapped.queryArc(0, 1)
        displayValue = events.length ? String(events[0].value) : '—'
      } else {
        displayValue = String(mapped)
      }
    }
    const columnSpacing = (this.canvas.width - 80 - width) / (this.topRow.length - 1)

    this.ctx.fillText(
      displayValue,
      x + width / 2,
      y - 10,
      Math.max(1, columnSpacing - 8)
    )
  }

  render() {

    this.ctx.drawImage(
      this.staticCanvas,
      0,
      0
    )

    this.topRow.forEach((n,i)=>
      this.drawMeter(
        n,
        i,
        0,
        '#ff9900'
      )
    )

    this.bottomRow.forEach((n,i)=>
      this.drawMeter(
        n,
        i,
        1,
        '#00ff66'
      )
    )
  }

  start() {

    super.start()

    const loop = (timestamp)=>{

      if (!this.running) return

      requestAnimationFrame(loop)

      if (
        timestamp - this.lastDrawTime <
        this.refreshMs
      ) return

      this.lastDrawTime = timestamp

      this.render()
    }

    requestAnimationFrame(loop)
  }

}

// Space visualiser for my space based music
class SpaceVisualiser extends CachedCanvasVisualiser {

  constructor({
    observer,
    Equator,
    KM_PER_AU,
    width = 960,
    height = 540,
    refreshMs = 60000
  }) {

    super(width,height)

    this.centerX = width / 2
    this.centerY = height / 2
    this.outerRadius = Math.min(width, height) * 0.44
    this.innerRadius = this.outerRadius * 220 / 260

    this.observer = observer
    this.Equator = Equator
    this.KM_PER_AU = KM_PER_AU

    this.refreshMs = refreshMs
    this.lastUpdate = 0

    this.planets = []

    this.zodiac = [
      '♈','♉','♊','♋',
      '♌','♍','♎','♏',
      '♐','♑','♒','♓'
    ]

    this.zodiacNames = [
      'Aries','Taurus',
      'Gemini','Cancer',
      'Leo','Virgo',
      'Libra','Scorpio',
      'Sagittarius',
      'Capricorn',
      'Aquarius',
      'Pisces'
    ]

    this.buildStaticLayer()
  }

  buildStaticLayer() {

    const ctx = this.staticCtx

    const { centerX: cx, centerY: cy, outerRadius, innerRadius } = this

    ctx.fillStyle = 'black'
    ctx.fillRect(
      0,
      0,
      this.canvas.width,
      this.canvas.height
    )

    ctx.strokeStyle = '#666'
    ctx.lineWidth = 2

    ctx.beginPath()
    ctx.arc(
      cx,
      cy,
      outerRadius,
      0,
      Math.PI * 2
    )
    ctx.stroke()

    ctx.beginPath()
    ctx.arc(
      cx,
      cy,
      innerRadius,
      0,
      Math.PI * 2
    )
    ctx.stroke()

    for(let i=0;i<12;i++){

      const angle =
        (i/12)*Math.PI*2 -
        Math.PI/2

      const x1 =
        cx + Math.cos(angle)*innerRadius

      const y1 =
        cy + Math.sin(angle)*innerRadius

      const x2 =
        cx + Math.cos(angle)*outerRadius

      const y2 =
        cy + Math.sin(angle)*outerRadius

      ctx.beginPath()
      ctx.moveTo(x1,y1)
      ctx.lineTo(x2,y2)
      ctx.stroke()

      const tx =
        cx + Math.cos(
          angle + Math.PI/12
        ) * (outerRadius * 240 / 260)

      const ty =
        cy + Math.sin(
          angle + Math.PI/12
        ) * (outerRadius * 240 / 260)

      ctx.fillStyle = '#aaa'

      ctx.font = '24px serif'
      ctx.fillText(
        this.zodiac[i],
        tx - 10,
        ty + 10
      )

      ctx.font = '12px monospace'
      ctx.fillText(
        this.zodiacNames[i],
        tx - 25,
        ty + 35
      )
    }
  }

  updatePlanetData() {

    const date = new Date()

    const moon =
      this.Equator(
        'Moon',
        date,
        this.observer,
        true,
        true
      )

    const mars =
      this.Equator(
        'Mars',
        date,
        this.observer,
        true,
        true
      )

    const sun =
      this.Equator(
        'Sun',
        date,
        this.observer,
        true,
        true
      )

    this.planets = [
      {
        label:
          '☉ '+
            Math.round(
              sun.dist *
              this.KM_PER_AU
            )
          +'km',
        ra:sun.ra,
        colour:'#ffcc00'
      },
      {
        label:
          '☽ '+
            Math.round(
              moon.dist *
              this.KM_PER_AU
              )
            +'km',
        ra:moon.ra,
        colour:'#ffffff'
      },
      {
        label:
          '♂ '+
            Math.round(
              mars.dist *
              this.KM_PER_AU
            )
          +'km',
        ra:mars.ra,
        colour:'#ff6666'
      }
    ]
  }

  drawPlanet(planet) {

    const { centerX: cx, centerY: cy, innerRadius: orbit } = this

    const angle =
      (planet.ra / 24) *
      Math.PI * 2 -
      Math.PI / 2

    const x =
      cx +
      Math.cos(angle) * orbit

    const y =
      cy +
      Math.sin(angle) * orbit

    this.ctx.fillStyle =
      planet.colour

    this.ctx.beginPath()

    this.ctx.arc(
      x,
      y,
      10,
      0,
      Math.PI * 2
    )

    this.ctx.fill()

    this.ctx.fillStyle='white'

    this.ctx.fillText(
      planet.label,
      x + 15,
      y
    )
  }

  render() {

    this.ctx.drawImage(
      this.staticCanvas,
      0,
      0
    )

    this.planets.forEach(
      planet => this.drawPlanet(planet)
    )
  }

  start() {

    super.start()

    this.updatePlanetData()
    this.render()

    const loop = ()=>{

      if (!this.running) return

      requestAnimationFrame(loop)

      const now = Date.now()

      if (
        now - this.lastUpdate <
        this.refreshMs
      ){
        return
      }

      this.lastUpdate = now

      this.updatePlanetData()
      this.render()
    }

    requestAnimationFrame(loop)
  }

}

window.MidiVisualiser = MidiVisualiser
window.SpaceVisualiser = SpaceVisualiser

// Scrolls lyric events on the same cycle clock and time axis as .pianoroll().
class LyricsVisualiser extends CachedCanvasVisualiser {
  constructor({
    pattern, width = 960, height = 180, cycles = 4, playhead = 0.5,
    lanes = 1, fontSize = 28, fontFamily = 'monospace',
    color = 'white', playheadColor = 'white'
  } = {}) {
    super(width, height)
    if (pattern !== undefined && (!pattern || typeof pattern.queryArc !== 'function')) {
      throw new TypeError('LyricsVisualiser pattern must be a Strudel pattern')
    }
    if (!Number.isFinite(width) || width <= 0 || !Number.isFinite(height) || height <= 0) {
      throw new RangeError('LyricsVisualiser width and height must be positive')
    }
    if (!Number.isFinite(cycles) || cycles <= 0 || !Number.isFinite(playhead) || playhead < 0 || playhead > 1) {
      throw new RangeError('LyricsVisualiser cycles must be positive and playhead must be between 0 and 1')
    }
    if (!Number.isSafeInteger(lanes) || lanes < 1 || !Number.isFinite(fontSize) || fontSize <= 0) {
      throw new RangeError('LyricsVisualiser lanes and fontSize must be positive')
    }
    window.lyricsVisualiser?.stop()
    window.lyricsVisualiser = this
    this.patterns = new Map()
    if (pattern !== undefined) this.patterns.set(Symbol('initial pattern'), { pattern, lane: 0 })
    this.cycles = cycles
    this.playhead = playhead
    this.lanes = lanes
    this.fontSize = fontSize
    this.fontFamily = fontFamily
    this.color = color
    this.playheadColor = playheadColor
    this.frame = undefined
  }

  add(label, pattern, lane = 0) {
    if (typeof label !== 'string' || !label) {
      throw new TypeError('LyricsVisualiser label must be a non-empty string')
    }
    if (!pattern || typeof pattern.queryArc !== 'function') {
      throw new TypeError('LyricsVisualiser pattern must be a Strudel pattern')
    }
    if (!Number.isSafeInteger(lane) || lane < 0 || lane >= this.lanes) {
      throw new RangeError('LyricsVisualiser lane must be an integer within the configured lanes')
    }
    this.patterns.set(label, { pattern, lane })
  }

  clear() {
    this.patterns.clear()
    this.render()
  }

  render() {
    const time = getTime()
    const start = time - this.cycles * this.playhead
    const end = start + this.cycles
    const ctx = this.ctx
    const width = this.canvas.width
    const height = this.canvas.height
    ctx.clearRect(0, 0, width, height)
    ctx.font = this.fontSize + 'px ' + this.fontFamily
    ctx.textAlign = 'left'
    ctx.textBaseline = 'middle'

    // Strudel's piano roll does not query events before playback starts.
    for (const entry of this.patterns.values()) {
      const events = end > 0 ? entry.pattern.queryArc(Math.max(0, start), end) : []
      for (const event of events) {
        const value = event.value
        const data = value !== null && typeof value === 'object' ? value : { text: value }
        const text = data.text ?? data.label ?? data.value
        if (text === undefined || text === null) continue
        const lane = data.lane ?? entry.lane
        if (!Number.isSafeInteger(lane) || lane < 0 || lane >= this.lanes) {
          throw new RangeError('LyricsVisualiser event lane must be an integer within the configured lanes')
        }
        const begin = Number((event.whole ?? event.part).begin)
        const finish = Number(event.whole ? event.endClipped ?? event.whole.end : event.part.end)
        if (!Number.isFinite(begin) || !Number.isFinite(finish) || finish <= begin) continue
        const x = width * (begin - start) / this.cycles
        const y = height * (lane + 0.5) / this.lanes
        ctx.fillStyle = this.color
        ctx.fillStyle = data.color ?? this.color
        ctx.fillText(String(text), x, y)
        if (begin <= time && time < finish) {
          ctx.fillRect(x, y + this.fontSize * 0.6, ctx.measureText(String(text)).width, 2)
        }
      }
    }

    ctx.strokeStyle = this.playheadColor
    ctx.beginPath()
    ctx.moveTo(width * this.playhead, 0)
    ctx.lineTo(width * this.playhead, height)
    ctx.stroke()
  }

  start() {
    if (this.running) return
    super.start()
    const loop = () => {
      if (!this.running) return
      this.render()
      this.frame = requestAnimationFrame(loop)
    }
    this.frame = requestAnimationFrame(loop)
  }

  stop() {
    super.stop()
    if (this.frame !== undefined) cancelAnimationFrame(this.frame)
    this.frame = undefined
  }
}

window.LyricsVisualiser = LyricsVisualiser

Object.getPrototypeOf(silence).vis_lyrics = function(label, lane = 0) {
  if (arguments.length < 1 || arguments.length > 2 || typeof label !== 'string' || !label) {
    throw new Error('.vis_lyrics() expects a label and an optional lane')
  }
  if (!window.lyricsVisualiser) {
    throw new Error('Create a LyricsVisualiser before using .vis_lyrics()')
  }
  window.lyricsVisualiser.add(label, this, lane)
  return this
}

// Two 4/4 bars per page, up to four note groups, each with optional lyrics.
class ScoreVisualiser extends CachedCanvasVisualiser {
  constructor({ vexflow, width = 1920, height = 1080, leftPadding = 105 } = {}) {
    super(width, height)
    if (!vexflow?.Renderer || !vexflow?.StaveNote) {
      throw new TypeError('ScoreVisualiser requires VexFlow; use await createScoreVisualiser()')
    }
    if (!Number.isFinite(width) || width < 800 || !Number.isFinite(height) || height < 200) {
      throw new RangeError('ScoreVisualiser requires width >= 800 and height >= 200')
    }
    if (!Number.isFinite(leftPadding) || leftPadding < 0 || leftPadding > width / 2) {
      throw new RangeError('ScoreVisualiser leftPadding must be between 0 and half the width')
    }
    this.leftPadding = leftPadding
    this.scale = 1
    window.scoreVisualiser?.stop()
    window.scoreVisualiser = this
    this.vexflow = vexflow
    this.groups = new Map()
    this.renderer = new vexflow.Renderer(this.staticCanvas, vexflow.Renderer.Backends.CANVAS)
    this.scoreContext = this.renderer.getContext()
    this.lastPage = undefined
    this.lastRefresh = -Infinity
    this.frame = undefined
  }

  add(label, kind, pattern) {
    if (label && typeof label.queryArc === 'function') {
      label = label.queryArc(0, 1).map(event => String(event.value)).join(' ')
    }
    if (typeof label !== 'string' || !label.trim()) {
      throw new TypeError('Score group label must be a non-empty string or text pattern')
    }
    if (!['notes', 'lyrics'].includes(kind)) throw new TypeError('Score pattern must be notes or lyrics')
    if (!pattern || typeof pattern.queryArc !== 'function') throw new TypeError('Score input must be a Strudel pattern')
    const group = this.groups.get(label) ?? {}
    if (!this.groups.has(label) && this.groups.size >= 4) throw new RangeError('ScoreVisualiser supports at most 4 groups')
    group[kind] = pattern
    this.groups.set(label, group)
    this.lastPage = undefined
  }

  clear() {
    this.groups.clear()
    this.lastPage = undefined
    this.render()
  }

  pitch(value) {
    const data = value !== null && typeof value === 'object' ? value : { note: value }
    let input = data.note ?? data.n ?? data.value
    if (typeof input === 'string' && input.trim() !== '' && Number.isFinite(Number(input))) input = Number(input)
    if (input === undefined && typeof data.freq === 'number' && data.freq > 0) {
      input = 69 + 12 * Math.log2(data.freq / 440)
    }
    if (typeof input === 'number' && Number.isFinite(input)) {
      input = Math.round(input)
      if (input < 0 || input > 127) throw new RangeError('Score pitch must be within MIDI 0-127')
      const names = ['c', 'c#', 'd', 'd#', 'e', 'f', 'f#', 'g', 'g#', 'a', 'a#', 'b']
      return { key: names[input % 12] + '/' + (Math.floor(input / 12) - 1), midi: input }
    }
    const match = typeof input === 'string' && /^([a-g])([#sb♭♯]?)(-?\d+)$/i.exec(input)
    if (!match) throw new Error('Score notes must have a pitch such as c4, eb3 or a MIDI number, got ' + JSON.stringify(value))
    const letter = match[1].toLowerCase()
    const accidental = match[2].toLowerCase().replace('s', '#').replace('♯', '#').replace('♭', 'b')
    const semitones = { c: 0, d: 2, e: 4, f: 5, g: 7, a: 9, b: 11 }
    const midi = (Number(match[3]) + 1) * 12 + semitones[letter] + (accidental === '#' ? 1 : accidental === 'b' ? -1 : 0)
    if (midi < 0 || midi > 127) throw new RangeError('Score pitch must be within MIDI 0-127')
    return { key: letter + accidental + '/' + match[3], midi }
  }

  grid(time, bar) {
    const value = (time - bar) * 16
    const rounded = Math.round(value)
    if (!Number.isFinite(value) || Math.abs(value - rounded) > 1e-6) {
      throw new RangeError('Score supports note boundaries on a sixteenth-note grid, not tuplets or irregular timing')
    }
    return rounded
  }

  barEvents(pattern, bar) {
    if (!pattern) return []
    return pattern.queryArc(bar, bar + 1).map(event => {
      if (!event.whole) throw new TypeError('Score notes must be discrete events')
      const begin = Number(event.whole.begin)
      const end = Number(event.endClipped ?? event.whole.end)
      const partBegin = Math.max(begin, Number(event.part.begin), bar)
      const partEnd = Math.min(end, Number(event.part.end), bar + 1)
      if (!Number.isFinite(begin) || !Number.isFinite(end) || end <= begin) {
        throw new RangeError('Score note has an invalid duration')
      }
      return { begin, end, from: this.grid(partBegin, bar), to: this.grid(partEnd, bar),
        pitch: this.pitch(event.value), color: event.value?.color }
    }).filter(event => event.to > event.from).sort((a, b) => a.from - b.from)
  }

  durations(length) {
    const choices = [
      [16, 'w', false], [12, 'h', true], [8, 'h', false], [6, 'q', true],
      [4, 'q', false], [3, '8', true], [2, '8', false], [1, '16', false]
    ]
    const result = []
    while (length > 0) {
      const choice = choices.find(([units]) => units <= length)
      result.push(choice)
      length -= choice[0]
    }
    return result
  }

  buildBar(events, clef) {
    const v = this.vexflow
    const notes = []
    const accidentals = new Map()
    let position = 0
    const append = (from, to, event) => {
      let cursor = from
      for (const [units, duration, dotted] of this.durations(to - from)) {
        const note = new v.StaveNote({
          clef, keys: [event ? event.pitch.key : clef === 'bass' ? 'd/3' : 'b/4'],
          duration: duration + (dotted ? 'd' : '') + (event ? '' : 'r')
        })
        if (dotted) v.Dot.buildAndAttach([note], { all: true })
        if (event) {
          const pitch = /^([a-g])([#b]?)(\/-?\d+)$/.exec(event.pitch.key)
          const name = pitch[1] + pitch[3]
          const accidental = pitch[2]
          if (accidental) note.addModifier(new v.Accidental(accidental), 0)
          else if (accidentals.get(name)) note.addModifier(new v.Accidental('n'), 0)
          accidentals.set(name, accidental)
        }
        const color = event?.color ?? 'white'
        const style = { fillStyle: color, strokeStyle: color }
        note.setStyle(style)
        note.setStemStyle(style)
        note.setFlagStyle(style)
        note.getModifiers().forEach(m => m.setStyle(style))
        notes.push({ note, at: cursor, event, units })
        cursor += units
      }
    }
    for (const event of events) {
      if (event.from < position) throw new RangeError('Score groups must be monophonic; use a separate group for overlapping notes')
      if (event.from > position) append(position, event.from)
      append(event.from, event.to, event)
      position = event.to
    }
    if (position < 16) append(position, 16)
    return notes
  }

  drawPage(page) {
    const v = this.vexflow
    const ctx = this.scoreContext
    const raw = this.staticCtx
    const groups = [...this.groups.entries()]
    const rowHeight = 170
    // Staff drawing is scaled up to use the available width, limited by canvas height.
    const scale = Math.min(
      (this.canvas.width - this.leftPadding - 10) / 2 / 300,
      this.canvas.height / (Math.max(groups.length, 1) * rowHeight + 40)
    )
    this.scale = scale
    raw.setTransform(1, 0, 0, 1, 0, 0)
    raw.clearRect(0, 0, this.canvas.width, this.canvas.height)
    raw.fillStyle = 'black'
    raw.fillRect(0, 0, this.canvas.width, this.canvas.height)
    raw.scale(scale, scale)
    raw.fillStyle = 'white'
    raw.font = '14px sans-serif'
    raw.fillText('Bars ' + (page + 1) + '–' + (page + 2) + '  (4/4)', 10, 20)
    const contentX = this.leftPadding / scale
    const barWidth = (this.canvas.width / scale - contentX - 10) / 2
    const staves = groups.map(([label, group], row) => {
      const bars = Array.from({ length: 2 }, (_, i) => this.barEvents(group.notes, page + i))
      const pitches = bars.flat().map(event => event.pitch.midi)
      const clef = pitches.length
        ? (pitches.reduce((a, b) => a + b, 0) / pitches.length < 60 ? 'bass' : 'treble')
        : group.clef ?? 'treble'
      group.clef = clef
      raw.fillStyle = 'white'
      raw.font = '14px sans-serif'
      raw.fillText(label, 10, 80 + row * rowHeight, Math.max(1, contentX - 15))
      return { label, group, bars, clef, row, last: undefined }
    })
    this.barAnchors = []
    for (let i = 0; i < 2; i++) {
      const voices = []
      const formatted = []
      for (const staff of staves) {
        raw.fillStyle = 'white'
        raw.strokeStyle = 'white'
        const stave = new v.Stave(contentX + i * barWidth, 35 + staff.row * rowHeight, barWidth)
        if (i === 0) stave.addClef(staff.clef).addTimeSignature('4/4')
        stave.setContext(ctx).draw()
        const items = this.buildBar(staff.bars[i], staff.clef)
        const voice = new v.Voice({ numBeats: 4, beatValue: 4 }).addTickables(items.map(item => item.note))
        voices.push(voice)
        formatted.push({ staff, stave, items, voice })
      }
      if (!voices.length) continue
      const formatter = new v.Formatter()
      voices.forEach(voice => formatter.joinVoices([voice]))
      formatter.formatToStave(voices, formatted[0].stave)
      for (const { voice, stave } of formatted) {
        raw.fillStyle = 'white'
        raw.strokeStyle = 'white'
        voice.draw(ctx, stave)
      }
      const positions = new Map()
      for (const { items } of formatted) {
        for (const item of items) positions.set(item.at / 16, item.note.getAbsoluteX())
      }
      positions.set(1, formatted[0].stave.getNoteEndX())
      const anchors = [...positions.entries()].sort((a, b) => a[0] - b[0])
      this.barAnchors.push(anchors)
      for (const { staff, stave, items, voice } of formatted) {
        raw.fillStyle = 'white'
        raw.strokeStyle = 'white'
        for (const item of items) {
          if (item.event) {
            const previous = staff.last
            if (previous && previous.event.begin === item.event.begin && previous.event.pitch.key === item.event.pitch.key) {
              new v.StaveTie({ firstNote: previous.note, lastNote: item.note }).setContext(ctx).draw()
            } else if (item.event.begin < page && i === 0) {
              new v.StaveTie({ lastNote: item.note }).setContext(ctx).draw()
            }
            staff.last = item
          } else {
            staff.last = undefined
          }
        }
        if (staff.group.lyrics) {
          const lyrics = staff.group.lyrics.queryArc(page + i, page + i + 1)
          raw.font = '15px sans-serif'
          raw.textBaseline = 'middle'
          for (const event of lyrics) {
            if (!event.whole || Number(event.whole.begin) < page + i || Number(event.whole.begin) >= page + i + 1) continue
            const value = event.value
            const data = value !== null && typeof value === 'object' ? value : { value }
            const text = data.text ?? data.label ?? data.value
            if (text === undefined || text === null) continue
            const offset = Number(event.whole.begin) - page - i
            const index = Math.max(0, anchors.findIndex((anchor, n) => n + 1 < anchors.length && offset < anchors[n + 1][0]))
            const [t0, x0] = anchors[index]
            const [t1, x1] = anchors[index + 1]
            const x = x0 + (x1 - x0) * (offset - t0) / (t1 - t0)
            raw.fillStyle = data.color ?? 'white'
            raw.fillText(String(text), x, 145 + staff.row * rowHeight)
          }
        }
      }
    }
    for (const staff of staves) {
      if (staff.last?.event.end > page + 2) {
        new v.StaveTie({ firstNote: staff.last.note }).setContext(ctx).draw()
      }
    }
  }

  render() {
    const time = Math.max(0, getTime())
    const page = Math.floor(time / 2) * 2
    const now = performance.now()
    if (page !== this.lastPage || now - this.lastRefresh >= 500) {
      this.drawPage(page)
      this.lastPage = page
      this.lastRefresh = now
    }
    this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height)
    this.ctx.drawImage(this.staticCanvas, 0, 0)
    const bar = Math.min(1, Math.floor(time - page))
    const anchors = this.barAnchors[bar]
    let x = this.leftPadding + (this.canvas.width - this.leftPadding - 10) * (time - page) / 2
    if (anchors) {
      const offset = time - page - bar
      const index = Math.max(0, anchors.findIndex((anchor, n) => n + 1 < anchors.length && offset < anchors[n + 1][0]))
      const [t0, x0] = anchors[index]
      const [t1, x1] = anchors[index + 1]
      x = (x0 + (x1 - x0) * (offset - t0) / (t1 - t0)) * this.scale
    }
    this.ctx.strokeStyle = '#d33'
    this.ctx.beginPath()
    this.ctx.moveTo(x, 30 * this.scale)
    this.ctx.lineTo(x, Math.min(this.canvas.height, (30 + this.groups.size * 170) * this.scale))
    this.ctx.stroke()
  }

  start() {
    if (this.running) return
    super.start()
    const loop = () => {
      if (!this.running) return
      try {
        this.render()
      } catch (error) {
        this.stop()
        this.ctx.fillStyle = 'white'
        this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height)
        this.ctx.fillStyle = '#b00'
        this.ctx.font = '16px sans-serif'
        this.ctx.fillText('Score error: ' + error.message, 10, 30, this.canvas.width - 20)
        console.error('ScoreVisualiser stopped:', error)
        return
      }
      this.frame = requestAnimationFrame(loop)
    }
    this.frame = requestAnimationFrame(loop)
  }

  stop() {
    super.stop()
    if (this.frame !== undefined) cancelAnimationFrame(this.frame)
    this.frame = undefined
  }
}

window.ScoreVisualiser = ScoreVisualiser
window.createScoreVisualiser = async (options = {}) => {
  const vexflow = await import('https://cdn.jsdelivr.net/npm/vexflow@5.0.0/build/esm/entry/vexflow.js')
  await document.fonts.ready
  return new ScoreVisualiser({ ...options, vexflow })
}

Object.getPrototypeOf(silence).vis_score_notes = function(label) {
  if (!window.scoreVisualiser) throw new Error('Create a ScoreVisualiser before using .vis_score_notes()')
  window.scoreVisualiser.add(label, 'notes', this)
  return this
}

Object.getPrototypeOf(silence).vis_score_lyrics = function(label) {
  if (!window.scoreVisualiser) throw new Error('Create a ScoreVisualiser before using .vis_score_lyrics()')
  window.scoreVisualiser.add(label, 'lyrics', this)
  return this
}

// Labels are unique per display type; text entries share one row.
// .vis_value(label, offset) samples offset cycles from the current position.
// .vis_cycles(label, count, offset) shows whole cycles from the current cycle.
class PatternVisualiser extends CachedCanvasVisualiser {
  constructor({ rows = 4, width = 960, height = 540, refreshMs = 500, leftPadding = 80 } = {}) {
    super(width, height)

    if (!Number.isInteger(rows) || rows < 1) {
      throw new RangeError('PatternVisualiser rows must be a positive integer')
    }
    if (!Number.isFinite(leftPadding) || leftPadding < 0) {
      throw new RangeError('PatternVisualiser leftPadding must be a non-negative number')
    }

    window.patternVisualiser?.stop()
    window.patternVisualiser = this
    this.rows = rows
    this.refreshMs = refreshMs
    this.leftPadding = leftPadding
    this.entries = new Map()
    this.lastDrawTime = 0
    this.lastContent = undefined
    this.render()
  }

  add(label, pattern, type, detailLabel, detailValue, offset = 0, cycles = 4) {
    const key = JSON.stringify([type, label])
    const entries = new Map(this.entries)
    entries.set(key, { label, pattern, type })
    const textEntries = [...entries.values()].filter(entry => entry.type === 'text')
    const patternCount = entries.size - textEntries.length
    if (patternCount + (textEntries.length ? 1 : 0) > this.rows) {
      console.warn('PatternVisualiser has no free row for', label)
      return
    }

    const entry = { label, pattern, type, detailLabel, detailValue, offset, cycles }
    if (type === 'pattern') {
      entry.events = []
      for (let cycle = 0; cycle < 4; cycle++) {
        entry.events.push(...pattern.queryArc(cycle, cycle + 1))
      }
    }
    this.entries.set(key, entry)
    this.render()
  }

  value(source) {
    if (source && typeof source.queryArc === 'function') {
      const events = source.queryArc(0, 1)
      return events.length ? events[0].value : '—'
    }
    return source
  }

  liveValue(source, cycle) {
    if (!source || typeof source.queryArc !== 'function') return source
    const events = source.queryArc(cycle, cycle + 1 / 65536)
      .filter(event => Number(event.part.begin) <= cycle + 1e-10)
    if (!events.length) return '—'
    return events.map(event => {
      const value = event.value
      return value !== null && typeof value === 'object' ? JSON.stringify(value) : String(value)
    }).join(', ')
  }

  clear() {
    this.entries.clear()
    this.render()
  }

  pitch(value) {
    const data = value !== null && typeof value === 'object' ? value : { note: value }
    const note = data.note ?? data.n
    if (typeof note === 'number' && Number.isFinite(note)) return note
    if (typeof note === 'string') {
      const match = /^([a-g])([#sb♭♯]*)(-?\d+)$/i.exec(note)
      if (match) {
        const semitones = { c: 0, d: 2, e: 4, f: 5, g: 7, a: 9, b: 11 }
        const accidentals = [...match[2]].reduce(
          (sum, accidental) => sum + ('#s♯'.includes(accidental.toLowerCase()) ? 1 : -1),
          0
        )
        return (Number(match[3]) + 1) * 12 + semitones[match[1].toLowerCase()] + accidentals
      }
    }
    if (typeof data.freq === 'number' && data.freq > 0) {
      return 69 + 12 * Math.log2(data.freq / 440)
    }
    return String(note ?? data.s ?? 'event')
  }

  noteLabel(value) {
    if (value !== null && typeof value === 'object') {
      if (typeof value.note === 'string') return value.note
      if (Number.isInteger(value.note)) {
        const names = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B']
        const pitchClass = ((value.note % 12) + 12) % 12
        return names[pitchClass] + (Math.floor(value.note / 12) - 1)
      }
      return String(value.note ?? value.n ?? value.s ?? 'event')
    }
    return String(value)
  }

  drawPattern(entry, x, y, width, height, start = 0, cycles = 4, showLabels = false) {
    const ctx = this.ctx
    ctx.fillStyle = '#181818'
    ctx.fillRect(x, y, width, height)
    ctx.strokeStyle = '#555'
    for (let i = 0; i <= cycles; i++) {
      const lineX = x + width * i / cycles
      ctx.beginPath()
      ctx.moveTo(lineX, y)
      ctx.lineTo(lineX, y + height)
      ctx.stroke()
    }

    const pitches = [...new Set(entry.events.map(event => this.pitch(event.value)))]
      .sort((a, b) => {
        if (typeof a === 'number' && typeof b === 'number') return b - a
        if (typeof a === 'number') return -1
        if (typeof b === 'number') return 1
        return a.localeCompare(b)
      })
    const noteHeight = height / Math.max(pitches.length, 1)

    for (const event of entry.events) {
      const begin = Math.max(start, Number(event.part.begin))
      const end = Math.min(start + cycles, Number(event.part.end))
      if (!Number.isFinite(begin) || !Number.isFinite(end) || end <= begin) continue
      const pitchIndex = pitches.indexOf(this.pitch(event.value))
      const color = event.value?.color ?? '#9b7cde'
      ctx.fillStyle = '#9b7cde'
      ctx.fillStyle = color
      const noteX = x + width * (begin - start) / cycles
      const noteY = y + pitchIndex * noteHeight + 1
      const noteWidth = Math.max(1, width * (end - begin) / cycles - 1)
      const noteBoxHeight = Math.max(1, noteHeight - 2)
      ctx.fillRect(noteX, noteY, noteWidth, noteBoxHeight)
      if (showLabels && noteWidth >= 18 && noteBoxHeight >= 12) {
        ctx.save()
        ctx.beginPath()
        ctx.rect(noteX, noteY, noteWidth, noteBoxHeight)
        ctx.clip()
        ctx.font = Math.min(14, noteBoxHeight * 0.75) + 'px monospace'
        ctx.fillStyle = 'white'
        ctx.fillText(this.noteLabel(event.value), noteX + 2, noteY + noteBoxHeight / 2, noteWidth - 4)
        ctx.restore()
      }
    }
  }

  render() {
    const ctx = this.ctx
    const width = this.canvas.width
    const entries = [...this.entries.values()]
    const cycle = entries.some(entry => entry.type === 'value' || entry.type === 'cycles') ? getTime() : undefined
    const cycleViews = new Map(entries.filter(entry => entry.type === 'cycles').map(entry => {
      const start = Math.floor(cycle) + entry.offset
      return [entry, { start, events: entry.pattern.queryArc(start, start + entry.cycles) }]
    }))
    const values = new Map(entries.map(entry => [
      entry,
      entry.type === 'value' ? String(this.liveValue(entry.pattern, cycle + entry.offset))
        : entry.type === 'text' ? String(this.value(entry.pattern))
        : entry.detailLabel !== undefined ? String(this.value(entry.detailValue)) : undefined
    ]))
    const content = JSON.stringify([
      width, this.canvas.height, this.rows, this.leftPadding,
      entries.map(entry => [
        entry.label, entry.type, entry.detailLabel, values.get(entry),
        entry.type === 'cycles' ? cycleViews.get(entry).start : undefined,
        entry.type === 'pattern' || entry.type === 'cycles'
          ? (entry.type === 'pattern' ? entry.events : cycleViews.get(entry).events).map(event => [
          Number(event.part.begin), Number(event.part.end),
          this.pitch(event.value), event.value?.color,
          entry.type === 'cycles' ? this.noteLabel(event.value) : undefined
        ]) : undefined
      ])
    ])
    if (content === this.lastContent) return

    const rowHeight = this.canvas.height / this.rows
    const padding = Math.min(10, rowHeight / 4, width / 4)
    const left = Math.min(Math.max(padding, this.leftPadding), width / 2)
    const boxWidth = width - left - padding
    const boxHeight = rowHeight - padding * 2
    const headerHeight = Math.min(35, boxHeight * 0.4)
    const fontSize = Math.min(16, boxHeight * 0.3)
    ctx.fillStyle = 'black'
    ctx.fillRect(0, 0, width, this.canvas.height)
    ctx.font = fontSize+'px monospace'
    ctx.textAlign = 'left'
    ctx.textBaseline = 'middle'

    const textEntries = entries.filter(entry => entry.type === 'text')
    let textDrawn = false
    let row = 0
    for (const entry of entries) {
      if (entry.type === 'text' && textDrawn) continue
      const top = row * rowHeight + padding
      ctx.save()
      ctx.beginPath()
      ctx.rect(left, top, boxWidth, boxHeight)
      ctx.clip()
      if (entry.type === 'pattern' || entry.type === 'cycles') {
        let heading = entry.label
        const view = cycleViews.get(entry)
        if (view) heading += '  |  cycles ' + view.start + '–' + (view.start + entry.cycles - 1)
        if (entry.detailLabel !== undefined) {
          heading += '  |  ' + entry.detailLabel + ' = ' + values.get(entry)
        }
        ctx.fillStyle = 'white'
        ctx.fillText(heading, left, top + headerHeight / 2, boxWidth)
        if (view) {
          this.drawPattern({ events: view.events }, left, top + headerHeight,
            boxWidth, boxHeight - headerHeight, view.start, entry.cycles, true)
        } else {
          this.drawPattern(entry, left, top + headerHeight, boxWidth, boxHeight - headerHeight)
        }
      } else if (entry.type === 'value') {
        ctx.fillStyle = '#181818'
        ctx.fillRect(left, top, boxWidth, boxHeight)
        ctx.fillStyle = '#ddd'
        ctx.fillText(entry.label, left + 5, top + headerHeight / 2, boxWidth - 10)
        ctx.font = Math.max(1, Math.min(32, (boxHeight - headerHeight) * 0.7)) + 'px monospace'
        ctx.fillStyle = 'white'
        ctx.fillText(values.get(entry), left + 5,
          top + headerHeight + (boxHeight - headerHeight) / 2, boxWidth - 10)
        ctx.font = fontSize+'px monospace'
      } else {
        textDrawn = true
        const columns = Math.min(textEntries.length, Math.max(1, Math.min(3, Math.floor(boxWidth / 160))))
        const lines = Math.ceil(textEntries.length / columns)
        const cellWidth = boxWidth / columns
        const cellHeight = boxHeight / lines
        ctx.fillStyle = '#181818'
        ctx.fillRect(left, top, boxWidth, boxHeight)
        ctx.fillStyle = '#ddd'
        textEntries.forEach((textEntry, index) => {
          const x = left + (index % columns) * cellWidth
          const y = top + (Math.floor(index / columns) + 0.5) * cellHeight
          ctx.fillText(textEntry.label + ' = ' + values.get(textEntry), x, y, cellWidth - 5)
        })
      }
      ctx.restore()
      row++
    }
    this.lastContent = content
  }

  start() {
    if (this.running) return
    super.start()
    const loop = timestamp => {
      if (!this.running) return
      if (timestamp - this.lastDrawTime >= this.refreshMs) {
        this.lastDrawTime = timestamp
        this.render()
      }
      requestAnimationFrame(loop)
    }
    requestAnimationFrame(loop)
  }
}

window.PatternVisualiser = PatternVisualiser

const registerVisualiserRow = (type, labelPattern, pattern, detailLabel, detailValue, offset = 0, cycles = 4) => {
  if (!window.patternVisualiser) {
    throw new Error('Create a PatternVisualiser before using .vis(), .vis_text(), .vis_value(), vis_text() or vis_value()')
  }
  const label = typeof labelPattern === 'string'
    ? labelPattern
    : labelPattern.queryArc(0, 1).map(event => String(event.value)).join(' ')
  if (!label) throw new Error('Visualiser labels must not be empty')
  window.patternVisualiser.add(label, pattern, type, detailLabel, detailValue, offset, cycles)
  return pattern
}

register('vis', (label, pattern) => registerVisualiserRow('pattern', label, pattern), false)
register('vis_text', (label, pattern) => registerVisualiserRow('text', label, pattern), false)
register('vis_value', (label, pattern) => registerVisualiserRow('value', label, pattern), false)

window.vis_text = (label, value) => {
  if (typeof label !== 'string' || !label) {
    throw new Error('vis_text() label must be a non-empty string')
  }
  return registerVisualiserRow('text', label, value)
}

window.vis_value = (label, value, offset = 0) => {
  if (typeof label !== 'string' || !label) {
    throw new Error('vis_value() label must be a non-empty string')
  }
  if (!Number.isFinite(offset)) {
    throw new TypeError('vis_value() offset must be a finite number of cycles')
  }
  return registerVisualiserRow('value', label, value, undefined, undefined, offset)
}

Object.getPrototypeOf(silence).vis_value = function(label, offset = 0) {
  if (arguments.length < 1 || arguments.length > 2) {
    throw new Error('.vis_value() expects a label and an optional cycle offset')
  }
  if (!Number.isFinite(offset)) {
    throw new TypeError('.vis_value() offset must be a finite number of cycles')
  }
  return registerVisualiserRow('value', label, this, undefined, undefined, offset)
}

Object.getPrototypeOf(silence).vis_cycles = function(label, cycles, offset = 0) {
  if (arguments.length < 2 || arguments.length > 3 || typeof label !== 'string' || !label) {
    throw new Error('.vis_cycles() expects a label, cycle count and optional cycle offset')
  }
  if (!Number.isSafeInteger(cycles) || cycles < 1) {
    throw new RangeError('.vis_cycles() cycle count must be a positive safe integer')
  }
  if (!Number.isSafeInteger(offset)) {
    throw new RangeError('.vis_cycles() offset must be a whole number of cycles')
  }
  return registerVisualiserRow('cycles', label, this, undefined, undefined, offset, cycles)
}
// register() checks a fixed argument count, so allow both .vis(label) and
// .vis(label, detailLabel, detailValue) on its registered pattern method.
Object.getPrototypeOf(silence).vis = function(label, detailLabel, detailValue) {
  if (arguments.length !== 1 && arguments.length !== 3) {
    throw new Error('.vis() expects a label, optionally followed by a detail label and value')
  }
  if (arguments.length === 3 && (typeof detailLabel !== 'string' || !detailLabel)) {
    throw new Error('.vis() detail label must be a non-empty string')
  }
  return registerVisualiserRow('pattern', label, this, detailLabel, detailValue)
}


// track structure stuff

window.createTrack = () => Object.defineProperties({}, {
  all: {
    get() {
      return compileTrack(this);
    }
  },
  colors: {
    get() {
      return trackColors(this);
    }
  }
});

window.stemColorPalettes = {
  reds: { drums: "Crimson", bass: "DarkRed", lead: "Tomato", vocals: "LightCoral" },
  greens: { drums: "DarkGreen", bass: "ForestGreen", lead: "MediumSeaGreen", vocals: "PaleGreen" },
  blues: { drums: "MidnightBlue", bass: "Navy", lead: "RoyalBlue", vocals: "SkyBlue" },
  yellowsOranges: { drums: "SaddleBrown", bass: "DarkOrange", lead: "Gold", vocals: "Khaki" },
  pinksPurples: { drums: "Indigo", bass: "Purple", lead: "DeepPink", vocals: "Plum" },
  graysNeutrals: { drums: "Black", bass: "DimGray", lead: "SlateGray", vocals: "Gainsboro" }
};


var faderTypes = {
  cross:{
    left: {
      vocals: [1, 0, 0, 0, 0],
      lead:   [1, 1, 0, 0, 0],
      bass:   [1, 1, 1, 0, 0],
      drums:  [1, 1, 1, 1, 0]
    },
    right: {
      drums:  [0, 1, 1, 1, 1],
      bass:   [0, 0, 1, 1, 1],
      lead:   [0, 0, 0, 1, 1],
      vocals: [0, 0, 0, 0, 1]
    }
  },
  out_in: {
    left: {
      vocals:  [1, 0, 0, 0, 0, 0, 0, 0, 0], 
      lead:    [1, 1, 0, 0, 0, 0, 0, 0, 0], 
      bass:    [1, 1, 1, 0, 0, 0, 0, 0, 0], 
      drums:   [1, 1, 1, 1, 0.5, 0, 0, 0, 0],
    },
    right:{
      drums:  [0, 0, 0, 0, 0.5, 1, 1, 1, 1],
      bass:   [0, 0, 0, 0, 0, 0, 1, 1, 1], 
      lead:   [0, 0, 0, 0, 0, 0, 0, 1, 1], 
      vocals: [0, 0, 0, 0, 0, 0, 0, 0, 1]  
    }
  }
};


// Choose fader type 
// cross (the new drum come in when the vocal drop out)
// or out_in that cuts each intrument out before mixing the drum and putting the other side in
// var faderGains = faderTypes.cross;
var faderGains = faderTypes.out_in;
window.faderMax = faderGains.left.drums.length - 1

const coreKeys = ['drums', 'bass', 'lead', 'vocals'];

const trackColors = trackObj => trackObj.colorFamily && stemColorPalettes[trackObj.colorFamily]
  ? stemColorPalettes[trackObj.colorFamily]
  : stemColorPalettes.graysNeutrals;

const compileTrackLayers = (trackObj, transformStem) => {
  const compiledLayers = [];
  const activePalette = trackColors(trackObj);
  
  coreKeys.forEach(stem => {
    const rawPattern = trackObj[stem] || silence;
    compiledLayers.push(transformStem(rawPattern.color(activePalette[stem]), stem));
  });

  // Loop over Dynamic Stems (Always active on selected deck)
  Object.keys(trackObj).forEach(key => {
    if (!coreKeys.includes(key) && key !== 'colorFamily') {
      compiledLayers.push(trackObj[key]);
    }
  });

  return stack(...compiledLayers);
};

const compileTrack = trackObj => compileTrackLayers(trackObj, pattern => pattern);
window.compileTrack = compileTrack;

const compileTrackWithGain = (trackObj, faderIndex, side) =>
  compileTrackLayers(trackObj, (pattern, stem) => {
    const liveMaskSignal = pick(faderIndex, faderGains[side][stem]);
    return pattern.postgain(liveMaskSignal).mask(liveMaskSignal);
  });

window.compileTrackWithGain = compileTrackWithGain


function toSides(sections, faderIndex) {
  const names = Object.keys(sections);
  const left = [];
  const right = [];

  for (let i = 0; i < names.length - 1; i++) {
    if (i % 2 === 0) {
      left.push(compileTrackWithGain(sections[names[i]], faderIndex, 'left'));
      right.push(compileTrackWithGain(sections[names[i + 1]], faderIndex, 'right'));
    } else {
      left.push(compileTrackWithGain(sections[names[i + 1]], faderIndex, 'left'));
      right.push(compileTrackWithGain(sections[names[i]], faderIndex, 'right'));
    }
  }
  return { left, right };
}
window.toSides = toSides


async function extendedSamples(genre = 'EDM', beats_per_bar = 4) {
const sampleManifest = await fetch('http://localhost:5432/strudel.json').then((r) => r.json());
const metadata = sampleManifest._metadata
let filtered = Object.fromEntries(
    Object.entries(metadata)
        .filter(([k, v]) => v.key != 'unknown' 
          & v.beats_per_bar == beats_per_bar
          & v.genre == genre
        )
        
);


for (const [k, v] of Object.entries(filtered)) {
  v.name = k;
  v.bar = k+'_bar';
  v.short = k+'_short';
  v.long = k+'_long';
  
  v.cpm = v.bpm / v.beats_per_bar;
  v.bass_scale = v.key.replace(':', '1:')
  v.lead_scale = v.key.replace(':', '3:')
}

let choices = {}
for (const [k, v] of Object.entries(filtered)) {
  //choices.names.push(k)
  for (const [key, value] of Object.entries(v)) {
    if (!Object.hasOwn(choices, key)){
      choices[key] = []
    }
    choices[key].push(value)
  }   
}
return choices;
  }
window.extendedSamples = extendedSamples;

