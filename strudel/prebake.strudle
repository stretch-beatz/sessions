register('acidenv', (x, pat)=> pat.lpf(100).lpenv(x*9).lps(.2).lpd(9.12))

window.smoothMix = (sources, speed = 0.1) => {
  let result = src(sources[0])

  for (let i = 1; i < sources.length; i++) {
    result = result.blend(
      src(sources[i]),
      () => (
        Math.sin(
          time * speed +
          i * (Math.PI * 2 / sources.length)
        ) + 1
      ) / 2
      
    )
  }

  return result
}


window.baseMidin = (b, c, m, n, i) =>
  b(c(m).range(0, (n**i)-1).round(), n, i)

class CachedCanvasVisualiser {

  constructor(width, height) {

    this.canvas = document.createElement('canvas')
    this.canvas.width = width
    this.canvas.height = height

    this.ctx = this.canvas.getContext('2d')

    this.staticCanvas = document.createElement('canvas')
    this.staticCanvas.width = width
    this.staticCanvas.height = height

    this.staticCtx = this.staticCanvas.getContext('2d')

    this.running = false
  }

  start() {
    this.running = true
  }

  stop() {
    this.running = false
  }

}

class MidiVisualiser extends CachedCanvasVisualiser {

  constructor({
    cc,
    width = 700,
    height = 600,
    refreshMs = 500
  }) {

    super(width, height)

    this.cc = cc
    this.refreshMs = refreshMs

    this.topRow = [21,22,23,24,25,26,27,28]
    this.bottomRow = [41,42,43,44,45,46,47,48]

    this.lastDrawTime = 0

    this.cachedValues = new Map()

    this.buildStaticLayer()
  }

  buildStaticLayer() {

    const ctx = this.staticCtx

    ctx.fillStyle = 'black'
    ctx.fillRect(0,0,this.width,this.height)

    const drawTrack = (ccNum,col,row) => {

      const x = 40 + col * 80
      const yOffset = row * 270

      ctx.fillStyle = '#222'
      ctx.fillRect(
        x,
        60 + yOffset,
        50,
        200
      )

      ctx.fillStyle = 'white'
      ctx.font = '16px monospace'
      ctx.fillText(
        ccNum,
        x + 12,
        285 + yOffset
      )
    }

    this.topRow.forEach((n,i)=>
      drawTrack(n,i,0))

    this.bottomRow.forEach((n,i)=>
      drawTrack(n,i,1))
  }

  getCCValue(n) {

    const value =
      this.cc(n).firstCycleValues?.[0] ?? 0

    const previous =
      this.cachedValues.get(n)

    if (previous === value) {
      return {
        changed:false,
        value
      }
    }

    this.cachedValues.set(n,value)

    return {
      changed:true,
      value
    }
  }

  drawMeter(n,col,row,color) {

    const { value } =
      this.getCCValue(n)

    const x = 40 + col * 80
    const yOffset = row * 270
    const h = value * 200

    this.ctx.fillStyle = color

    this.ctx.fillRect(
      x,
      260 + yOffset - h,
      50,
      h
    )

    this.ctx.fillStyle = 'white'
    this.ctx.font = '16px monospace'

    this.ctx.fillText(
      value.toFixed(2),
      x - 2,
      50 + yOffset
    )
  }

  render() {

    this.ctx.drawImage(
      this.staticCanvas,
      0,
      0
    )

    this.topRow.forEach((n,i)=>
      this.drawMeter(
        n,
        i,
        0,
        '#ff9900'
      )
    )

    this.bottomRow.forEach((n,i)=>
      this.drawMeter(
        n,
        i,
        1,
        '#00ff66'
      )
    )
  }

  start() {

    super.start()

    const loop = (timestamp)=>{

      if (!this.running) return

      requestAnimationFrame(loop)

      if (
        timestamp - this.lastDrawTime <
        this.refreshMs
      ) return

      this.lastDrawTime = timestamp

      this.render()
    }

    requestAnimationFrame(loop)
  }

}


class SpaceVisualiser extends CachedCanvasVisualiser {

  constructor({
    observer,
    Equator,
    KM_PER_AU,
    width = 700,
    height = 700,
    refreshMs = 60000
  }) {

    super(width,height)

    this.observer = observer
    this.Equator = Equator
    this.KM_PER_AU = KM_PER_AU

    this.refreshMs = refreshMs
    this.lastUpdate = 0

    this.planets = []

    this.zodiac = [
      '♈','♉','♊','♋',
      '♌','♍','♎','♏',
      '♐','♑','♒','♓'
    ]

    this.zodiacNames = [
      'Aries','Taurus',
      'Gemini','Cancer',
      'Leo','Virgo',
      'Libra','Scorpio',
      'Sagittarius',
      'Capricorn',
      'Aquarius',
      'Pisces'
    ]

    this.buildStaticLayer()
  }

  buildStaticLayer() {

    const ctx = this.staticCtx

    const cx = 350
    const cy = 300

    const outerR = 260
    const innerR = 220

    ctx.fillStyle = 'black'
    ctx.fillRect(
      0,
      0,
      this.canvas.width,
      this.canvas.height
    )

    ctx.strokeStyle = '#666'
    ctx.lineWidth = 2

    ctx.beginPath()
    ctx.arc(
      cx,
      cy,
      outerR,
      0,
      Math.PI * 2
    )
    ctx.stroke()

    ctx.beginPath()
    ctx.arc(
      cx,
      cy,
      innerR,
      0,
      Math.PI * 2
    )
    ctx.stroke()

    for(let i=0;i<12;i++){

      const angle =
        (i/12)*Math.PI*2 -
        Math.PI/2

      const x1 =
        cx + Math.cos(angle)*innerR

      const y1 =
        cy + Math.sin(angle)*innerR

      const x2 =
        cx + Math.cos(angle)*outerR

      const y2 =
        cy + Math.sin(angle)*outerR

      ctx.beginPath()
      ctx.moveTo(x1,y1)
      ctx.lineTo(x2,y2)
      ctx.stroke()

      const tx =
        cx + Math.cos(
          angle + Math.PI/12
        ) * 240

      const ty =
        cy + Math.sin(
          angle + Math.PI/12
        ) * 240

      ctx.fillStyle = '#aaa'

      ctx.font = '24px serif'
      ctx.fillText(
        this.zodiac[i],
        tx - 10,
        ty + 10
      )

      ctx.font = '12px monospace'
      ctx.fillText(
        this.zodiacNames[i],
        tx - 25,
        ty + 35
      )
    }
  }

  updatePlanetData() {

    const date = new Date()

    const moon =
      this.Equator(
        'Moon',
        date,
        this.observer,
        true,
        true
      )

    const mars =
      this.Equator(
        'Mars',
        date,
        this.observer,
        true,
        true
      )

    const sun =
      this.Equator(
        'Sun',
        date,
        this.observer,
        true,
        true
      )

    this.planets = [
      {
        label:
          '☉ '+
            Math.round(
              sun.dist *
              this.KM_PER_AU
            )
          +'km',
        ra:sun.ra,
        colour:'#ffcc00'
      },
      {
        label:
          '☽ '+
            Math.round(
              moon.dist *
              this.KM_PER_AU
              )
            +'km',
        ra:moon.ra,
        colour:'#ffffff'
      },
      {
        label:
          '♂ '+
            Math.round(
              mars.dist *
              this.KM_PER_AU
            )
          +'km',
        ra:mars.ra,
        colour:'#ff6666'
      }
    ]
  }

  drawPlanet(planet) {

    const cx = 350
    const cy = 300
    const orbit = 220

    const angle =
      (planet.ra / 24) *
      Math.PI * 2 -
      Math.PI / 2

    const x =
      cx +
      Math.cos(angle) * orbit

    const y =
      cy +
      Math.sin(angle) * orbit

    this.ctx.fillStyle =
      planet.colour

    this.ctx.beginPath()

    this.ctx.arc(
      x,
      y,
      10,
      0,
      Math.PI * 2
    )

    this.ctx.fill()

    this.ctx.fillStyle='white'

    this.ctx.fillText(
      planet.label,
      x + 15,
      y
    )
  }

  render() {

    this.ctx.drawImage(
      this.staticCanvas,
      0,
      0
    )

    this.planets.forEach(
      planet => this.drawPlanet(planet)
    )
  }

  start() {

    super.start()

    this.updatePlanetData()
    this.render()

    const loop = ()=>{

      if (!this.running) return

      requestAnimationFrame(loop)

      const now = Date.now()

      if (
        now - this.lastUpdate <
        this.refreshMs
      ){
        return
      }

      this.lastUpdate = now

      this.updatePlanetData()
      this.render()
    }

    requestAnimationFrame(loop)
  }

}

window.MidiVisualiser = MidiVisualiser
window.SpaceVisualiser = SpaceVisualiser
