//borrowed from switch angel
register('acidenv', (x, pat)=> pat.lpf(100).lpenv(x*9).lps(.2).lpd(9.12))


// https://gist.github.com/walfie/b049d32368cb579a5980d4fb49d416ba
const romanChordMapping = { i: 0, ii: 1, iii: 2, iv: 3, v: 4, vi: 5, vii: 6 }
register('romanChord', function (scaleName, pat) {
  return pat.as("roman:chordSuffix").fmap(({ roman, chordSuffix}) => {
    const lower = roman.toLowerCase();
    return n(romanChordMapping[lower]).scale(scaleName).fmap(value => {
      return value.note.slice(0, -1) + (roman == lower ? 'm' : '') + (chordSuffix || '');
    }).chord();
  }).outerJoin();
});


//mix hydra sources together
window.smoothMix = (sources, speed = 0.1) => {
  let result = src(sources[0])

  for (let i = 1; i < sources.length; i++) {
    result = result.blend(
      src(sources[i]),
      () => (
        Math.sin(
          time * speed +
          i * (Math.PI * 2 / sources.length)
        ) + 1
      ) / 2      
    )
  }
  return result
}

//Need to add this to strudel
window.baseMidin = (b, c, m, n, i) =>
  b(c(m).range(0, (n**i)-1).round(), n, i)

// Base Class for Canvas visulaisers
class CachedCanvasVisualiser {
  constructor(width, height) {

    this.canvas = document.createElement('canvas')
    this.canvas.width = width
    this.canvas.height = height

    this.ctx = this.canvas.getContext('2d')

    this.staticCanvas = document.createElement('canvas')
    this.staticCanvas.width = width
    this.staticCanvas.height = height

    this.staticCtx = this.staticCanvas.getContext('2d')

    this.running = false
  }

  start() {
    this.running = true
  }

  stop() {
    this.running = false
  }

}

// Shows Midi based around the layout of my Novation  Launch Control
class MidiVisualiser extends CachedCanvasVisualiser {

  constructor({
    cc,
    width = 960,
    height = 540,
    refreshMs = 500
  }, valueMappings = {}) {

    super(width, height)

    if (valueMappings === null || typeof valueMappings !== 'object' || Array.isArray(valueMappings)) {
      throw new TypeError('MidiVisualiser value mappings must be an object keyed by CC number')
    }

    this.cc = cc
    this.refreshMs = refreshMs
    this.valueMappings = valueMappings

    this.topRow = [21,22,23,24,25,26,27,28]
    this.bottomRow = [41,42,43,44,45,46,47,48]

    this.lastDrawTime = 0

    this.cachedValues = new Map()

    this.buildStaticLayer()
  }

  getTrackGeometry(col,row) {
    const trackWidth = 50
    const rowHeight = this.canvas.height / 2
    const trackHeight = Math.min(180, rowHeight * 2 / 3)
    const horizontalMargin = 40
    const columnSpacing =
      (this.canvas.width - horizontalMargin * 2 - trackWidth) /
      (this.topRow.length - 1)

    return {
      x: horizontalMargin + col * columnSpacing,
      y: row * rowHeight + (rowHeight - trackHeight) / 2,
      width: trackWidth,
      height: trackHeight
    }
  }

  buildStaticLayer() {

    const ctx = this.staticCtx

    ctx.fillStyle = 'black'
    ctx.fillRect(0,0,this.canvas.width,this.canvas.height)

    const drawTrack = (ccNum,col,row) => {

      const { x, y, width, height } =
        this.getTrackGeometry(col,row)

      ctx.fillStyle = '#222'
      ctx.fillRect(
        x,
        y,
        width,
        height
      )

      ctx.fillStyle = 'white'
      ctx.font = '16px monospace'
      ctx.fillText(
        ccNum,
        x + 12,
        y + height + 22
      )
    }

    this.topRow.forEach((n,i)=>
      drawTrack(n,i,0))

    this.bottomRow.forEach((n,i)=>
      drawTrack(n,i,1))
  }

  getCCValue(n) {

    const value =
      this.cc(n).firstCycleValues?.[0] ?? 0

    const previous =
      this.cachedValues.get(n)

    if (previous === value) {
      return {
        changed:false,
        value
      }
    }

    this.cachedValues.set(n,value)

    return {
      changed:true,
      value
    }
  }

  drawMeter(n,col,row,color) {

    const { value } =
      this.getCCValue(n)

    const { x, y, width, height } =
      this.getTrackGeometry(col,row)
    const h = value * height

    this.ctx.fillStyle = color

    this.ctx.fillRect(
      x,
      y + height - h,
      width,
      h
    )

    this.ctx.fillStyle = 'white'
    this.ctx.font = '16px monospace'
    this.ctx.textAlign = 'center'

    let displayValue = value.toFixed(2)
    if (Object.hasOwn(this.valueMappings, n)) {
      const mapped = this.valueMappings[n]
      if (mapped !== null && typeof mapped === 'object' && typeof mapped.queryArc === 'function') {
        const events = mapped.queryArc(0, 1)
        displayValue = events.length ? String(events[0].value) : '—'
      } else {
        displayValue = String(mapped)
      }
    }
    const columnSpacing = (this.canvas.width - 80 - width) / (this.topRow.length - 1)

    this.ctx.fillText(
      displayValue,
      x + width / 2,
      y - 10,
      Math.max(1, columnSpacing - 8)
    )
  }

  render() {

    this.ctx.drawImage(
      this.staticCanvas,
      0,
      0
    )

    this.topRow.forEach((n,i)=>
      this.drawMeter(
        n,
        i,
        0,
        '#ff9900'
      )
    )

    this.bottomRow.forEach((n,i)=>
      this.drawMeter(
        n,
        i,
        1,
        '#00ff66'
      )
    )
  }

  start() {

    super.start()

    const loop = (timestamp)=>{

      if (!this.running) return

      requestAnimationFrame(loop)

      if (
        timestamp - this.lastDrawTime <
        this.refreshMs
      ) return

      this.lastDrawTime = timestamp

      this.render()
    }

    requestAnimationFrame(loop)
  }

}

// Space visualiser for my space based music
class SpaceVisualiser extends CachedCanvasVisualiser {

  constructor({
    observer,
    Equator,
    KM_PER_AU,
    width = 960,
    height = 540,
    refreshMs = 60000
  }) {

    super(width,height)

    this.centerX = width / 2
    this.centerY = height / 2
    this.outerRadius = Math.min(width, height) * 0.44
    this.innerRadius = this.outerRadius * 220 / 260

    this.observer = observer
    this.Equator = Equator
    this.KM_PER_AU = KM_PER_AU

    this.refreshMs = refreshMs
    this.lastUpdate = 0

    this.planets = []

    this.zodiac = [
      '♈','♉','♊','♋',
      '♌','♍','♎','♏',
      '♐','♑','♒','♓'
    ]

    this.zodiacNames = [
      'Aries','Taurus',
      'Gemini','Cancer',
      'Leo','Virgo',
      'Libra','Scorpio',
      'Sagittarius',
      'Capricorn',
      'Aquarius',
      'Pisces'
    ]

    this.buildStaticLayer()
  }

  buildStaticLayer() {

    const ctx = this.staticCtx

    const { centerX: cx, centerY: cy, outerRadius, innerRadius } = this

    ctx.fillStyle = 'black'
    ctx.fillRect(
      0,
      0,
      this.canvas.width,
      this.canvas.height
    )

    ctx.strokeStyle = '#666'
    ctx.lineWidth = 2

    ctx.beginPath()
    ctx.arc(
      cx,
      cy,
      outerRadius,
      0,
      Math.PI * 2
    )
    ctx.stroke()

    ctx.beginPath()
    ctx.arc(
      cx,
      cy,
      innerRadius,
      0,
      Math.PI * 2
    )
    ctx.stroke()

    for(let i=0;i<12;i++){

      const angle =
        (i/12)*Math.PI*2 -
        Math.PI/2

      const x1 =
        cx + Math.cos(angle)*innerRadius

      const y1 =
        cy + Math.sin(angle)*innerRadius

      const x2 =
        cx + Math.cos(angle)*outerRadius

      const y2 =
        cy + Math.sin(angle)*outerRadius

      ctx.beginPath()
      ctx.moveTo(x1,y1)
      ctx.lineTo(x2,y2)
      ctx.stroke()

      const tx =
        cx + Math.cos(
          angle + Math.PI/12
        ) * (outerRadius * 240 / 260)

      const ty =
        cy + Math.sin(
          angle + Math.PI/12
        ) * (outerRadius * 240 / 260)

      ctx.fillStyle = '#aaa'

      ctx.font = '24px serif'
      ctx.fillText(
        this.zodiac[i],
        tx - 10,
        ty + 10
      )

      ctx.font = '12px monospace'
      ctx.fillText(
        this.zodiacNames[i],
        tx - 25,
        ty + 35
      )
    }
  }

  updatePlanetData() {

    const date = new Date()

    const moon =
      this.Equator(
        'Moon',
        date,
        this.observer,
        true,
        true
      )

    const mars =
      this.Equator(
        'Mars',
        date,
        this.observer,
        true,
        true
      )

    const sun =
      this.Equator(
        'Sun',
        date,
        this.observer,
        true,
        true
      )

    this.planets = [
      {
        label:
          '☉ '+
            Math.round(
              sun.dist *
              this.KM_PER_AU
            )
          +'km',
        ra:sun.ra,
        colour:'#ffcc00'
      },
      {
        label:
          '☽ '+
            Math.round(
              moon.dist *
              this.KM_PER_AU
              )
            +'km',
        ra:moon.ra,
        colour:'#ffffff'
      },
      {
        label:
          '♂ '+
            Math.round(
              mars.dist *
              this.KM_PER_AU
            )
          +'km',
        ra:mars.ra,
        colour:'#ff6666'
      }
    ]
  }

  drawPlanet(planet) {

    const { centerX: cx, centerY: cy, innerRadius: orbit } = this

    const angle =
      (planet.ra / 24) *
      Math.PI * 2 -
      Math.PI / 2

    const x =
      cx +
      Math.cos(angle) * orbit

    const y =
      cy +
      Math.sin(angle) * orbit

    this.ctx.fillStyle =
      planet.colour

    this.ctx.beginPath()

    this.ctx.arc(
      x,
      y,
      10,
      0,
      Math.PI * 2
    )

    this.ctx.fill()

    this.ctx.fillStyle='white'

    this.ctx.fillText(
      planet.label,
      x + 15,
      y
    )
  }

  render() {

    this.ctx.drawImage(
      this.staticCanvas,
      0,
      0
    )

    this.planets.forEach(
      planet => this.drawPlanet(planet)
    )
  }

  start() {

    super.start()

    this.updatePlanetData()
    this.render()

    const loop = ()=>{

      if (!this.running) return

      requestAnimationFrame(loop)

      const now = Date.now()

      if (
        now - this.lastUpdate <
        this.refreshMs
      ){
        return
      }

      this.lastUpdate = now

      this.updatePlanetData()
      this.render()
    }

    requestAnimationFrame(loop)
  }

}

window.MidiVisualiser = MidiVisualiser
window.SpaceVisualiser = SpaceVisualiser

// Labels are unique per display type; text entries share one row.
// .vis_value(label, offset) samples offset cycles from the current position.
// .vis_cycles(label, count, offset) shows whole cycles from the current cycle.
class PatternVisualiser extends CachedCanvasVisualiser {
  constructor({ rows = 4, width = 960, height = 540, refreshMs = 500, leftPadding = 80 } = {}) {
    super(width, height)

    if (!Number.isInteger(rows) || rows < 1) {
      throw new RangeError('PatternVisualiser rows must be a positive integer')
    }
    if (!Number.isFinite(leftPadding) || leftPadding < 0) {
      throw new RangeError('PatternVisualiser leftPadding must be a non-negative number')
    }

    window.patternVisualiser?.stop()
    window.patternVisualiser = this
    this.rows = rows
    this.refreshMs = refreshMs
    this.leftPadding = leftPadding
    this.entries = new Map()
    this.lastDrawTime = 0
    this.lastContent = undefined
    this.render()
  }

  add(label, pattern, type, detailLabel, detailValue, offset = 0, cycles = 4) {
    const key = JSON.stringify([type, label])
    const entries = new Map(this.entries)
    entries.set(key, { label, pattern, type })
    const textEntries = [...entries.values()].filter(entry => entry.type === 'text')
    const patternCount = entries.size - textEntries.length
    if (patternCount + (textEntries.length ? 1 : 0) > this.rows) {
      console.warn('PatternVisualiser has no free row for', label)
      return
    }

    const entry = { label, pattern, type, detailLabel, detailValue, offset, cycles }
    if (type === 'pattern') {
      entry.events = []
      for (let cycle = 0; cycle < 4; cycle++) {
        entry.events.push(...pattern.queryArc(cycle, cycle + 1))
      }
    }
    this.entries.set(key, entry)
    this.render()
  }

  value(source) {
    if (source && typeof source.queryArc === 'function') {
      const events = source.queryArc(0, 1)
      return events.length ? events[0].value : '—'
    }
    return source
  }

  liveValue(source, cycle) {
    if (!source || typeof source.queryArc !== 'function') return source
    const events = source.queryArc(cycle, cycle + 1 / 65536)
      .filter(event => Number(event.part.begin) <= cycle + 1e-10)
    if (!events.length) return '—'
    return events.map(event => {
      const value = event.value
      return value !== null && typeof value === 'object' ? JSON.stringify(value) : String(value)
    }).join(', ')
  }

  clear() {
    this.entries.clear()
    this.render()
  }

  pitch(value) {
    const data = value !== null && typeof value === 'object' ? value : { note: value }
    const note = data.note ?? data.n
    if (typeof note === 'number' && Number.isFinite(note)) return note
    if (typeof note === 'string') {
      const match = /^([a-g])([#sb♭♯]*)(-?\d+)$/i.exec(note)
      if (match) {
        const semitones = { c: 0, d: 2, e: 4, f: 5, g: 7, a: 9, b: 11 }
        const accidentals = [...match[2]].reduce(
          (sum, accidental) => sum + ('#s♯'.includes(accidental.toLowerCase()) ? 1 : -1),
          0
        )
        return (Number(match[3]) + 1) * 12 + semitones[match[1].toLowerCase()] + accidentals
      }
    }
    if (typeof data.freq === 'number' && data.freq > 0) {
      return 69 + 12 * Math.log2(data.freq / 440)
    }
    return String(note ?? data.s ?? 'event')
  }

  noteLabel(value) {
    if (value !== null && typeof value === 'object') {
      if (typeof value.note === 'string') return value.note
      if (Number.isInteger(value.note)) {
        const names = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B']
        const pitchClass = ((value.note % 12) + 12) % 12
        return names[pitchClass] + (Math.floor(value.note / 12) - 1)
      }
      return String(value.note ?? value.n ?? value.s ?? 'event')
    }
    return String(value)
  }

  drawPattern(entry, x, y, width, height, start = 0, cycles = 4, showLabels = false) {
    const ctx = this.ctx
    ctx.fillStyle = '#181818'
    ctx.fillRect(x, y, width, height)
    ctx.strokeStyle = '#555'
    for (let i = 0; i <= cycles; i++) {
      const lineX = x + width * i / cycles
      ctx.beginPath()
      ctx.moveTo(lineX, y)
      ctx.lineTo(lineX, y + height)
      ctx.stroke()
    }

    const pitches = [...new Set(entry.events.map(event => this.pitch(event.value)))]
      .sort((a, b) => {
        if (typeof a === 'number' && typeof b === 'number') return b - a
        if (typeof a === 'number') return -1
        if (typeof b === 'number') return 1
        return a.localeCompare(b)
      })
    const noteHeight = height / Math.max(pitches.length, 1)

    for (const event of entry.events) {
      const begin = Math.max(start, Number(event.part.begin))
      const end = Math.min(start + cycles, Number(event.part.end))
      if (!Number.isFinite(begin) || !Number.isFinite(end) || end <= begin) continue
      const pitchIndex = pitches.indexOf(this.pitch(event.value))
      const color = event.value?.color ?? '#9b7cde'
      ctx.fillStyle = '#9b7cde'
      ctx.fillStyle = color
      const noteX = x + width * (begin - start) / cycles
      const noteY = y + pitchIndex * noteHeight + 1
      const noteWidth = Math.max(1, width * (end - begin) / cycles - 1)
      const noteBoxHeight = Math.max(1, noteHeight - 2)
      ctx.fillRect(noteX, noteY, noteWidth, noteBoxHeight)
      if (showLabels && noteWidth >= 18 && noteBoxHeight >= 12) {
        ctx.save()
        ctx.beginPath()
        ctx.rect(noteX, noteY, noteWidth, noteBoxHeight)
        ctx.clip()
        ctx.font = Math.min(14, noteBoxHeight * 0.75) + 'px monospace'
        ctx.fillStyle = 'white'
        ctx.fillText(this.noteLabel(event.value), noteX + 2, noteY + noteBoxHeight / 2, noteWidth - 4)
        ctx.restore()
      }
    }
  }

  render() {
    const ctx = this.ctx
    const width = this.canvas.width
    const entries = [...this.entries.values()]
    const cycle = entries.some(entry => entry.type === 'value' || entry.type === 'cycles') ? getTime() : undefined
    const cycleViews = new Map(entries.filter(entry => entry.type === 'cycles').map(entry => {
      const start = Math.floor(cycle) + entry.offset
      return [entry, { start, events: entry.pattern.queryArc(start, start + entry.cycles) }]
    }))
    const values = new Map(entries.map(entry => [
      entry,
      entry.type === 'value' ? String(this.liveValue(entry.pattern, cycle + entry.offset))
        : entry.type === 'text' ? String(this.value(entry.pattern))
        : entry.detailLabel !== undefined ? String(this.value(entry.detailValue)) : undefined
    ]))
    const content = JSON.stringify([
      width, this.canvas.height, this.rows, this.leftPadding,
      entries.map(entry => [
        entry.label, entry.type, entry.detailLabel, values.get(entry),
        entry.type === 'cycles' ? cycleViews.get(entry).start : undefined,
        entry.type === 'pattern' || entry.type === 'cycles'
          ? (entry.type === 'pattern' ? entry.events : cycleViews.get(entry).events).map(event => [
          Number(event.part.begin), Number(event.part.end),
          this.pitch(event.value), event.value?.color,
          entry.type === 'cycles' ? this.noteLabel(event.value) : undefined
        ]) : undefined
      ])
    ])
    if (content === this.lastContent) return

    const rowHeight = this.canvas.height / this.rows
    const padding = Math.min(10, rowHeight / 4, width / 4)
    const left = Math.min(Math.max(padding, this.leftPadding), width / 2)
    const boxWidth = width - left - padding
    const boxHeight = rowHeight - padding * 2
    const headerHeight = Math.min(35, boxHeight * 0.4)
    const fontSize = Math.min(16, boxHeight * 0.3)
    ctx.fillStyle = 'black'
    ctx.fillRect(0, 0, width, this.canvas.height)
    ctx.font = fontSize+'px monospace'
    ctx.textAlign = 'left'
    ctx.textBaseline = 'middle'

    const textEntries = entries.filter(entry => entry.type === 'text')
    let textDrawn = false
    let row = 0
    for (const entry of entries) {
      if (entry.type === 'text' && textDrawn) continue
      const top = row * rowHeight + padding
      ctx.save()
      ctx.beginPath()
      ctx.rect(left, top, boxWidth, boxHeight)
      ctx.clip()
      if (entry.type === 'pattern' || entry.type === 'cycles') {
        let heading = entry.label
        const view = cycleViews.get(entry)
        if (view) heading += '  |  cycles ' + view.start + '–' + (view.start + entry.cycles - 1)
        if (entry.detailLabel !== undefined) {
          heading += '  |  ' + entry.detailLabel + ' = ' + values.get(entry)
        }
        ctx.fillStyle = 'white'
        ctx.fillText(heading, left, top + headerHeight / 2, boxWidth)
        if (view) {
          this.drawPattern({ events: view.events }, left, top + headerHeight,
            boxWidth, boxHeight - headerHeight, view.start, entry.cycles, true)
        } else {
          this.drawPattern(entry, left, top + headerHeight, boxWidth, boxHeight - headerHeight)
        }
      } else if (entry.type === 'value') {
        ctx.fillStyle = '#181818'
        ctx.fillRect(left, top, boxWidth, boxHeight)
        ctx.fillStyle = '#ddd'
        ctx.fillText(entry.label, left + 5, top + headerHeight / 2, boxWidth - 10)
        ctx.font = Math.max(1, Math.min(32, (boxHeight - headerHeight) * 0.7)) + 'px monospace'
        ctx.fillStyle = 'white'
        ctx.fillText(values.get(entry), left + 5,
          top + headerHeight + (boxHeight - headerHeight) / 2, boxWidth - 10)
        ctx.font = fontSize+'px monospace'
      } else {
        textDrawn = true
        const columns = Math.min(textEntries.length, Math.max(1, Math.min(3, Math.floor(boxWidth / 160))))
        const lines = Math.ceil(textEntries.length / columns)
        const cellWidth = boxWidth / columns
        const cellHeight = boxHeight / lines
        ctx.fillStyle = '#181818'
        ctx.fillRect(left, top, boxWidth, boxHeight)
        ctx.fillStyle = '#ddd'
        textEntries.forEach((textEntry, index) => {
          const x = left + (index % columns) * cellWidth
          const y = top + (Math.floor(index / columns) + 0.5) * cellHeight
          ctx.fillText(textEntry.label + ' = ' + values.get(textEntry), x, y, cellWidth - 5)
        })
      }
      ctx.restore()
      row++
    }
    this.lastContent = content
  }

  start() {
    if (this.running) return
    super.start()
    const loop = timestamp => {
      if (!this.running) return
      if (timestamp - this.lastDrawTime >= this.refreshMs) {
        this.lastDrawTime = timestamp
        this.render()
      }
      requestAnimationFrame(loop)
    }
    requestAnimationFrame(loop)
  }
}

window.PatternVisualiser = PatternVisualiser

const registerVisualiserRow = (type, labelPattern, pattern, detailLabel, detailValue, offset = 0, cycles = 4) => {
  if (!window.patternVisualiser) {
    throw new Error('Create a PatternVisualiser before using .vis(), .vis_text(), .vis_value(), vis_text() or vis_value()')
  }
  const label = typeof labelPattern === 'string'
    ? labelPattern
    : labelPattern.queryArc(0, 1).map(event => String(event.value)).join(' ')
  if (!label) throw new Error('Visualiser labels must not be empty')
  window.patternVisualiser.add(label, pattern, type, detailLabel, detailValue, offset, cycles)
  return pattern
}

register('vis', (label, pattern) => registerVisualiserRow('pattern', label, pattern), false)
register('vis_text', (label, pattern) => registerVisualiserRow('text', label, pattern), false)
register('vis_value', (label, pattern) => registerVisualiserRow('value', label, pattern), false)

window.vis_text = (label, value) => {
  if (typeof label !== 'string' || !label) {
    throw new Error('vis_text() label must be a non-empty string')
  }
  return registerVisualiserRow('text', label, value)
}

window.vis_value = (label, value, offset = 0) => {
  if (typeof label !== 'string' || !label) {
    throw new Error('vis_value() label must be a non-empty string')
  }
  if (!Number.isFinite(offset)) {
    throw new TypeError('vis_value() offset must be a finite number of cycles')
  }
  return registerVisualiserRow('value', label, value, undefined, undefined, offset)
}

Object.getPrototypeOf(silence).vis_value = function(label, offset = 0) {
  if (arguments.length < 1 || arguments.length > 2) {
    throw new Error('.vis_value() expects a label and an optional cycle offset')
  }
  if (!Number.isFinite(offset)) {
    throw new TypeError('.vis_value() offset must be a finite number of cycles')
  }
  return registerVisualiserRow('value', label, this, undefined, undefined, offset)
}

Object.getPrototypeOf(silence).vis_cycles = function(label, cycles, offset = 0) {
  if (arguments.length < 2 || arguments.length > 3 || typeof label !== 'string' || !label) {
    throw new Error('.vis_cycles() expects a label, cycle count and optional cycle offset')
  }
  if (!Number.isSafeInteger(cycles) || cycles < 1) {
    throw new RangeError('.vis_cycles() cycle count must be a positive safe integer')
  }
  if (!Number.isSafeInteger(offset)) {
    throw new RangeError('.vis_cycles() offset must be a whole number of cycles')
  }
  return registerVisualiserRow('cycles', label, this, undefined, undefined, offset, cycles)
}
// register() checks a fixed argument count, so allow both .vis(label) and
// .vis(label, detailLabel, detailValue) on its registered pattern method.
Object.getPrototypeOf(silence).vis = function(label, detailLabel, detailValue) {
  if (arguments.length !== 1 && arguments.length !== 3) {
    throw new Error('.vis() expects a label, optionally followed by a detail label and value')
  }
  if (arguments.length === 3 && (typeof detailLabel !== 'string' || !detailLabel)) {
    throw new Error('.vis() detail label must be a non-empty string')
  }
  return registerVisualiserRow('pattern', label, this, detailLabel, detailValue)
}


// track structure stuff

window.createTrack = () => Object.defineProperties({}, {
  all: {
    get() {
      return compileTrack(this);
    }
  },
  colors: {
    get() {
      return trackColors(this);
    }
  }
});

window.stemColorPalettes = {
  reds: { drums: "Crimson", bass: "DarkRed", lead: "Tomato", vocals: "LightCoral" },
  greens: { drums: "DarkGreen", bass: "ForestGreen", lead: "MediumSeaGreen", vocals: "PaleGreen" },
  blues: { drums: "MidnightBlue", bass: "Navy", lead: "RoyalBlue", vocals: "SkyBlue" },
  yellowsOranges: { drums: "SaddleBrown", bass: "DarkOrange", lead: "Gold", vocals: "Khaki" },
  pinksPurples: { drums: "Indigo", bass: "Purple", lead: "DeepPink", vocals: "Plum" },
  graysNeutrals: { drums: "Black", bass: "DimGray", lead: "SlateGray", vocals: "Gainsboro" }
};


var faderTypes = {
  cross:{
    left: {
      vocals: [1, 0, 0, 0, 0],
      lead:   [1, 1, 0, 0, 0],
      bass:   [1, 1, 1, 0, 0],
      drums:  [1, 1, 1, 1, 0]
    },
    right: {
      drums:  [0, 1, 1, 1, 1],
      bass:   [0, 0, 1, 1, 1],
      lead:   [0, 0, 0, 1, 1],
      vocals: [0, 0, 0, 0, 1]
    }
  },
  out_in: {
    left: {
      vocals:  [1, 0, 0, 0, 0, 0, 0, 0, 0], 
      lead:    [1, 1, 0, 0, 0, 0, 0, 0, 0], 
      bass:    [1, 1, 1, 0, 0, 0, 0, 0, 0], 
      drums:   [1, 1, 1, 1, 0.5, 0, 0, 0, 0],
    },
    right:{
      drums:  [0, 0, 0, 0, 0.5, 1, 1, 1, 1],
      bass:   [0, 0, 0, 0, 0, 0, 1, 1, 1], 
      lead:   [0, 0, 0, 0, 0, 0, 0, 1, 1], 
      vocals: [0, 0, 0, 0, 0, 0, 0, 0, 1]  
    }
  }
};


// Choose fader type 
// cross (the new drum come in when the vocal drop out)
// or out_in that cuts each intrument out before mixing the drum and putting the other side in
// var faderGains = faderTypes.cross;
var faderGains = faderTypes.out_in;
window.faderMax = faderGains.left.drums.length - 1

const coreKeys = ['drums', 'bass', 'lead', 'vocals'];

const trackColors = trackObj => trackObj.colorFamily && stemColorPalettes[trackObj.colorFamily]
  ? stemColorPalettes[trackObj.colorFamily]
  : stemColorPalettes.graysNeutrals;

const compileTrackLayers = (trackObj, transformStem) => {
  const compiledLayers = [];
  const activePalette = trackColors(trackObj);
  
  coreKeys.forEach(stem => {
    const rawPattern = trackObj[stem] || silence;
    compiledLayers.push(transformStem(rawPattern.color(activePalette[stem]), stem));
  });

  // Loop over Dynamic Stems (Always active on selected deck)
  Object.keys(trackObj).forEach(key => {
    if (!coreKeys.includes(key) && key !== 'colorFamily') {
      compiledLayers.push(trackObj[key]);
    }
  });

  return stack(...compiledLayers);
};

const compileTrack = trackObj => compileTrackLayers(trackObj, pattern => pattern);
window.compileTrack = compileTrack;

const compileTrackWithGain = (trackObj, faderIndex, side) =>
  compileTrackLayers(trackObj, (pattern, stem) => {
    const liveMaskSignal = pick(faderIndex, faderGains[side][stem]);
    return pattern.postgain(liveMaskSignal).mask(liveMaskSignal);
  });

window.compileTrackWithGain = compileTrackWithGain


function toSides(sections, faderIndex) {
  const names = Object.keys(sections);
  const left = [];
  const right = [];

  for (let i = 0; i < names.length - 1; i++) {
    if (i % 2 === 0) {
      left.push(compileTrackWithGain(sections[names[i]], faderIndex, 'left'));
      right.push(compileTrackWithGain(sections[names[i + 1]], faderIndex, 'right'));
    } else {
      left.push(compileTrackWithGain(sections[names[i + 1]], faderIndex, 'left'));
      right.push(compileTrackWithGain(sections[names[i]], faderIndex, 'right'));
    }
  }
  return { left, right };
}
window.toSides = toSides


async function extendedSamples(genre = 'EDM', beats_per_bar = 4) {
const sampleManifest = await fetch('http://localhost:5432/strudel.json').then((r) => r.json());
const metadata = sampleManifest._metadata
let filtered = Object.fromEntries(
    Object.entries(metadata)
        .filter(([k, v]) => v.key != 'unknown' 
          & v.beats_per_bar == beats_per_bar
          & v.genre == genre
        )
        
);


for (const [k, v] of Object.entries(filtered)) {
  v.name = k;
  v.bar = k+'_bar';
  v.short = k+'_short';
  v.long = k+'_long';
  
  v.cpm = v.bpm / v.beats_per_bar;
  v.bass_scale = v.key.replace(':', '1:')
  v.lead_scale = v.key.replace(':', '3:')
}

let choices = {}
for (const [k, v] of Object.entries(filtered)) {
  //choices.names.push(k)
  for (const [key, value] of Object.entries(v)) {
    if (!Object.hasOwn(choices, key)){
      choices[key] = []
    }
    choices[key].push(value)
  }   
}
return choices;
  }
window.extendedSamples = extendedSamples;
